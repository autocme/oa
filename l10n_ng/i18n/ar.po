#. module: l10n_ng
#: model:account.report.line,name:l10n_ng.l10n_ng_tr_a_10
msgid "10. Total Sales/Income Exclusive of VAT"
msgstr "10. المبيعات/الإيرادات الإجمالية باستثناء ضريبة القيمة المضافة"

#. module: l10n_ng
#: model:account.report.line,name:l10n_ng.l10n_ng_tr_c_100
msgid "100. Previous Unrelieved VAT Credit Brought Forward"
