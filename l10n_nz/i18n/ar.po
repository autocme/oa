#. module: l10n_nz
#: model:account.report.line,name:l10n_nz.tax_report_box10
msgid "[BOX 10] Total GST collected on sales and income"
msgstr ""
"[الصندوق 10] إجمالي ضريبة القيمة المضافة المحصلة من المبيعات والإيرادات"

#. module: l10n_nz
#: model:account.report.line,name:l10n_nz.tax_report_box11
msgid ""
"[BOX 11] Total purchases and expenses(including GST) for which tax invoicing"
" requirements have been met"
msgstr ""
"[الصندوق 11] المشتريات والمصاريف الإجمالية (بما في ذلك ضريبة القيمة المضافة)"
" التي تم استيفاء متطلبات فوترتها الضريبية"

#. module: l10n_nz
#: model:account.report.line,name:l10n_nz.tax_report_box12
msgid "[BOX 12] Multiply BOX11 by 3 and then divide by 23"
msgstr ""
"[الصندوق 12] ضرب القيمة الموجودة في الصندوق 11 في 3، ثم قسمة الناتج على 23"

#. module: l10n_nz
#: model:account.report.line,name:l10n_nz.tax_report_box13_tags
msgid "[BOX 13] Amount computed from tax tags"
msgstr "[الصندوق 13] المبلغ المحسوب من علامات الضرائب"

#. module: l10n_nz
#: model:account.report.line,name:l10n_nz.tax_report_box13
msgid "[BOX 13] Credit adjustments from your calculation sheet"
msgstr "[الصندوق 13] تعديلات الائتمان من ورقة الحسابات الخاصة بك"

#. module: l10n_nz
#: model:account.report.line,name:l10n_nz.tax_report_box13_manual
msgid "[BOX 13] Manual adjustments"
msgstr "[الصندوق 13] تعديلات يدوية"

#. module: l10n_nz
#: model:account.report.line,name:l10n_nz.tax_report_box14
msgid "[BOX 14] Total GST credit for purchases and expenses"
msgstr ""
"[الصندوق 14] إجمالي الائتمان المتعلق بضريبة القيمة المضافة على المشتريات "
"والمصاريف"

#. module: l10n_nz
#: model:account.report.line,name:l10n_nz.tax_report_box15
msgid "[BOX 15] Difference between BOX10 and BOX14"
msgstr "[الصندوق 15] الفرق بين الصندوق 10 والصندوق 14"

#. module: l10n_nz
#: model:account.report.line,name:l10n_nz.tax_report_box5
msgid ""
"[BOX 5] Total sales and income for the period(including GST and zero-rated "
"Supplies)"
msgstr ""
"[الصندوق 5] إجمالي المبيعات والإيرادات للفترة (بما في ذلك ضريبة القيمة "
"المضافة والسلع ذات المعدل الضريبي صفر)"

#. module: l10n_nz
#: model:account.report.line,name:l10n_nz.tax_report_box6
msgid "[BOX 6] Zero-rated supplies in Box 5"
msgstr "[الصندوق 6] السلع ذات النسبة الصفرية في الصندوق 5"

#. module: l10n_nz
#: model:account.report.line,name:l10n_nz.tax_report_box7
msgid "[BOX 7] The amount in Box 6 is subracted from Box 5"
msgstr "[الصندوق 7] يتم خصم المبلغ الموجود في الصندوق 6 من الصندوق 5"

#. module: l10n_nz
#: model:account.report.line,name:l10n_nz.tax_report_box8
msgid "[BOX 8] Multiply the amount in Box 7 by 3 and then divide by 23"
msgstr ""
"[الصندوق 8] ضرب المبلغ الموجود في الصندوق 7 في 3، ثم قسمة الناتج على 23"

#. module: l10n_nz
#: model:account.report.line,name:l10n_nz.tax_report_box9
msgid "[BOX 9] Enter any adjustments from your calculation sheet"
msgstr "[الصندوق 9] أدخل أي تعديلات من ورقة الحسابات الخاصة بك"
