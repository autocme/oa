msgid "EU Sales and Purchases Excluding VAT"
msgstr "مبيعات ومشتريات الاتحاد الأوروبي باستثناء ضريبة القيمة المضافة"

#. module: l10n_uk
#: model:ir.model.fields,field_description:l10n_uk.field_account_chart_template__id
msgid "ID"
msgstr "المعرف"

#. module: l10n_uk
#: model:account.report.line,name:l10n_uk.account_tax_report_line_exd_vat
msgid "Sales and Purchases Excluding VAT"
msgstr "المبيعات والمشتريات باستثناء ضريبة القيمة المضافة"

#. module: l10n_uk
#: model:account.report,name:l10n_uk.tax_report
msgid "Tax Report"
msgstr "تقرير الضرائب"

#. module: l10n_uk
#: model:ir.ui.menu,name:l10n_uk.account_reports_uk_statements_menu
msgid "United Kingdom"
msgstr "المملكة المتحدة"

#. module: l10n_uk
#: model:res.country.group,name:l10n_uk.country_group_ukxi
msgid "United Kingdom and Northern Ireland"
msgstr "المملكة المتحدة وأيرلندا الشمالية"

#. module: l10n_uk
#: model:account.report.line,name:l10n_uk.account_tax_report_line_vat_cal
msgid "VAT Calculations"
msgstr "حسابات ضريبة القيمة المضافة"

#. module: l10n_uk
#: model:account.report.line,name:l10n_uk.account_tax_report_line_vat_box1
msgid "[BOX 1] VAT due on sales and other outputs"
msgstr ""
"[الصندوق 1] ضريبة القيمة المضافة المستحقة على المبيعات والمخرجات الأخرى"

#. module: l10n_uk
#: model:account.report.line,name:l10n_uk.account_tax_report_line_vat_box2
msgid ""
"[BOX 2] VAT due on acquisitions of goods made in Northern Ireland from EU "
"member states"
msgstr ""
"[الصندوق 2] ضريبة القيمة المضافة المستحقة على شراء السلع المصنوعة في أيرلندا"
" الشمالية من دول الاتحاد الأوروبي"

#. module: l10n_uk
#: model:account.report.line,name:l10n_uk.account_tax_report_line_vat_box3
msgid "[BOX 3] Total VAT due"
msgstr "[الصندوق 3] إجمالي ضريبة القيمة المضافة المستحقة"

#. module: l10n_uk
#: model:account.report.line,name:l10n_uk.account_tax_report_line_vat_box4
msgid ""
"[BOX 4] VAT reclaimed on purchases and other inputs (including acquisitions "
"from the EU)"
msgstr ""
"[الصندوق 4] ضريبة القيمة المضافة المستردة على المشتريات والمدخلات الأخرى "
"(بما في ذلك المشتريات من الاتحاد الأوروبي)"

#. module: l10n_uk
#: model:account.report.line,name:l10n_uk.account_tax_report_line_vat_box5
msgid "[BOX 5] VAT to pay/reclaim"
msgstr "[الصندوق 5] ضريبة القيمة المضافة المستحقة/القابلة للاسترداد"

#. module: l10n_uk
#: model:account.report.line,name:l10n_uk.account_tax_report_line_exd_vat_box6
msgid "[BOX 6] Total value of sales and all other outputs excluding any VAT"
msgstr ""
"[الصندوق 6] القيمة الإجمالية للمبيعات وجميع المخرجات الأخرى، باستثناء ضريبة "
"القيمة المضافة"

#. module: l10n_uk
#: model:account.report.line,name:l10n_uk.account_tax_report_line_exd_vat_box7
msgid "[BOX 7] Total value of purchases and all other inputs excluding VAT"
msgstr ""
"[الصندوق 7] القيمة الإجمالية للمشتريات وجميع المدخلات الأخرى باستثناء ضريبة "
"القيمة المضافة"

#. module: l10n_uk
#: model:account.report.line,name:l10n_uk.account_tax_report_line_exd_vat_box8
msgid ""
"[BOX 8] Total value of all supplies of goods and related costs, excluding "
"any VAT, to EU member states"
msgstr ""
"[الصندوق 8] القيمة الإجمالية لجميع إمدادات السلع والتكاليف المرتبطة بها، "
"باستثناء ضريبة القيمة المضافة، المخصصة لدول الاتحاد الأوروبي الأعضاء"

#. module: l10n_uk
#: model:account.report.line,name:l10n_uk.account_tax_report_line_exd_vat_box9
msgid ""
"[BOX 9] Total value of all acquisitions of goods and related costs, "
"excluding any VAT, from EU member states"
msgstr ""
"[الصندوق 9] القيمة الإجمالية لجميع عمليات الشراء من السلع والتكاليف المرتبطة"
" بها، باستثناء ضريبة القيمة المضافة، من دول الاتحاد الأوروبي الأعضاء"
